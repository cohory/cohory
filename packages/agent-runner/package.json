{
  "name": "@cohory/agent-runner",
  "version": "0.12.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Reference local evaluation runner for cohory agent courses. Runs JSON Schema checks only and talks to nothing but the cohory API.",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "cohory-agent-runner": "./src/cli.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "run-task": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cohory/config": "workspace:*",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
