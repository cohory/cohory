    "@cohory/rate-limit": "workspace:*",
    "@cohory/storage": "workspace:*",
    "@date-fns/tz": "1.4.1",
    "drizzle-orm": "0.45.4",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
