{
  "name": "@cohory/courses",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seed": "./src/seed.ts",
    "./agent-format": "./src/agent/index.ts",
    "./markdown": "./src/markdown.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
