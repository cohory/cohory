# cohory configuration for local use and a first Docker install.
#
#   cp .env.example .env
#   docker compose --profile mail up -d --build
#
# Then open http://localhost:3000 and read sign up emails in Mailpit at http://localhost:8025.
# Every value below works as is on this machine. Lines marked CHANGE FOR PRODUCTION must get your
# own values before anyone else can reach the server. For a public server, start from
# .env.production.example instead (docs/operations/install.md).

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# Signs sessions and tokens. CHANGE FOR PRODUCTION: `openssl rand -base64 32`.
# A production server on a host other than localhost refuses this placeholder.
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-32-characters

# Public URL of the server. Read at start, so changing it needs a restart, not a rebuild.
# CHANGE FOR PRODUCTION: https://community.example.com. Keep the three values equal; Docker
# Compose copies APP_URL into the other two when they are unset.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker Compose builds the database connection strings for the containers from these.
# Migrations connect as POSTGRES_USER (the schema owner); web and worker as POSTGRES_APP_USER,
# a role without BYPASSRLS so row level security applies. CHANGE FOR PRODUCTION: both passwords,
# letters and digits only (`openssl rand -hex 32`).
POSTGRES_USER=cohory
POSTGRES_PASSWORD=cohory
POSTGRES_DB=cohory
POSTGRES_APP_USER=cohory_app
POSTGRES_APP_PASSWORD=cohory_app

# Connection strings for tools you run outside Docker (pnpm dev, pnpm db:migrate). Compose
# ignores these lines. Keep the passwords equal to the POSTGRES_* values above. When
# DATABASE_ADMIN_URL is set to another user, migrations create the DATABASE_URL role.
DATABASE_URL=postgres://cohory:cohory@localhost:5433/cohory
# DATABASE_ADMIN_URL=postgres://cohory:cohory@localhost:5433/cohory

# ---------------------------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------------------------

# smtp works with any SMTP server, including Mailpit. log writes emails to the log instead.
EMAIL_DRIVER=smtp
# mailpit is the Mailpit container of the mail profile (`--profile mail`), whose inbox is at
# http://localhost:8025. Running the app outside Docker, use localhost.
# CHANGE FOR PRODUCTION: your provider's host, port 587, user, and password.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS. Empty means true on port 465 and false elsewhere.
SMTP_SECURE=
# true refuses to send without STARTTLS. Use it on port 587.
SMTP_REQUIRE_TLS=false
# Sender address. CHANGE FOR PRODUCTION: an address on the APP_URL domain or its parent, so
# SPF, DKIM, and DMARC line up. The sender name is INSTANCE_NAME.
SMTP_FROM=no-reply@localhost
# Optional address that replies go to.
SMTP_REPLY_TO=
# true lets production send from another domain. Only when your provider signs it with DKIM.
EMAIL_ALLOW_ANY_FROM=false
# Outgoing rate and SMTP pool size. Lower the rate to your provider's limit.
EMAIL_RATE_PER_SECOND=10
EMAIL_MAX_CONNECTIONS=3
# Signs POST /api/webhooks/email (bounces and complaints), at least 32 characters
# (`openssl rand -hex 32`). Empty turns the endpoint off.
EMAIL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------------------------
# Optional: Docker host ports
# ---------------------------------------------------------------------------------------------

# The web app is published on 127.0.0.1 only. Use the production overlay to serve a domain.
APP_PORT=3000
# APP_BIND=127.0.0.1
# Database port for local tools, localhost only.
# POSTGRES_HOST_PORT=127.0.0.1:5433
MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025

# ---------------------------------------------------------------------------------------------
# Optional: instance and access
# ---------------------------------------------------------------------------------------------

# Name in the header, page titles, and sign in text (default Cohory, at most 60 characters).
INSTANCE_NAME=
# Logo path such as /logo.svg, or a URL on the APP_URL origin. Empty shows the cohory icon.
INSTANCE_LOGO_URL=
# Community slug that signed out visitors see at / instead of the home page.
HOME_COMMUNITY=
# Slug of a community for the people who run communities here. Footers link to it, and new
# creators get one invite email to it.
CREATORS_COMMUNITY_SLUG=
# Who may create an account: open (default), invite (only through an active invite link), closed.
SIGNUP_MODE=
# Who may create a community: anyone (default) or operators, the confirmed emails listed in
# OPERATOR_EMAILS (comma separated, required with operators).
COMMUNITY_CREATION=
OPERATOR_EMAILS=
# false serves an empty /sitemap.xml. Default true.
SITEMAP_ENABLED=
# true allows an http:// URL on a host other than localhost, for a private network only.
# Anyone on that network can then read session cookies.
# ALLOW_INSECURE_HTTP=false

# ---------------------------------------------------------------------------------------------
# Optional: legal pages and contact (docs/self-hosting.md, Legal pages and contact)
# ---------------------------------------------------------------------------------------------

# Your own Terms, Privacy Policy, imprint, and community rules. Each shows in the footer when set.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
LEGAL_IMPRINT_URL=
LEGAL_GUIDELINES_URL=
# Address for the Contact and Report content forms. Empty turns both off.
CONTACT_EMAIL=
# Email or https URL for /.well-known/security.txt. Falls back to CONTACT_EMAIL.
SECURITY_CONTACT=
SECURITY_POLICY_URL=
# Where people get the source of the code this server runs. AGPL-3.0 section 13 asks you to
# offer it when you run a modified copy.
SOURCE_URL=
STATUS_URL=
# Facts the Cloud legal texts fill in. Blank values show as "[... not set]".
LEGAL_ENTITY=
GOVERNING_LAW=
DATA_REGION=
# Version of your Terms recorded at sign up (default 1). Raise it when the Terms change.
TERMS_VERSION=
# ISO date the legal pages show as last updated. Blank uses the bundled texts' date.
LEGAL_UPDATED_AT=

# ---------------------------------------------------------------------------------------------
# Optional: uploads
# ---------------------------------------------------------------------------------------------

# local keeps uploads on disk (the uploads volume in Docker); s3 uses any S3 compatible service.
STORAGE_DRIVER=local
# Folder for the local driver outside Docker. Docker always uses /data/uploads.
STORAGE_LOCAL_PATH=./data/uploads
# Largest upload in bytes (avatars have their own 5 MB limit).
STORAGE_MAX_UPLOAD_BYTES=10485760
# Base URL for serving uploads. Empty uses the built in /api/uploads route.
STORAGE_PUBLIC_BASE_URL=
# S3 driver only. Empty keys use the default AWS credential chain. Set path style for MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=

# ---------------------------------------------------------------------------------------------
# Optional: payments (docs/architecture/payments.md)
# ---------------------------------------------------------------------------------------------

# community: creators connect their own Stripe keys, no platform fee. Self-hosted servers keep it.
# cloud: Stripe Connect with an application fee, for the hosted Cloud Edition.
COHORY_EDITION=community
# Encrypts creators' own Stripe keys and Polar tokens at rest. Required before a creator connects
# payments. 32 bytes, base64 (`openssl rand -base64 32`). Back it up with the database. To rotate,
# list the new key first in PAYMENTS_ENCRYPTION_KEYS, restart, and run `pnpm secrets rotate`
# (docs/operations/operator-guide.md, Rotating secrets).
PAYMENTS_ENCRYPTION_KEY=
# PAYMENTS_ENCRYPTION_KEYS=
# Encrypts outgoing webhook signing secrets. Empty derives a key from BETTER_AUTH_SECRET.
WEBHOOKS_ENCRYPTION_KEY=
# WEBHOOKS_ENCRYPTION_KEYS=
# Cloud only. Platform fee in basis points (200 is 2%).
PLATFORM_FEE_BPS=200
# Cloud only. Platform Stripe secret key. Test mode keys (sk_test_ or rk_test_) everywhere except
# production; the server refuses live keys when NODE_ENV is not production.
STRIPE_SECRET_KEY=
# Cloud only. Signing secrets of /api/webhooks/stripe for account and connected account events.
# With the Stripe CLI (scripts/stripe-dev.sh) both are the one value the CLI prints.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Cloud only. Connect client id (ca_). Subscriptions created through it can be linked.
STRIPE_CONNECT_CLIENT_ID=
# Offer Polar as a payment provider. Off by default: Polar's acceptable use policy does not allow
# marketplaces or community access.
COHORY_ENABLE_POLAR=false
# Development only. Sandbox connected account (acct_) that `pnpm db:seed:paid` and
# `pnpm db:reset:local` connect to price Cohory Pro. Needs COHORY_EDITION=cloud and a sk_test_ key.
# PAID_SEED_ACCOUNT_ID=
# Test runs only. Base URLs of stand ins for Stripe and Polar. Leave empty.
STRIPE_API_BASE_URL=
POLAR_API_BASE_URL=
# Hosts that outgoing webhooks may reach although they are private or local. Leave empty on a
# public server.
EGRESS_ALLOW_PRIVATE_HOSTS=

# ---------------------------------------------------------------------------------------------
# Optional: limits and tuning (defaults shown; docs/self-hosting.md)
# ---------------------------------------------------------------------------------------------

# Fair use per community: a whole number or unlimited. No limits on the Community Edition unless
# set. FAIR_USE_PAID_* apply to communities that sell memberships.
# FAIR_USE_MEMBERS=unlimited
# FAIR_USE_STORAGE_BYTES=unlimited
# FAIR_USE_UPLOAD_BYTES=unlimited
# FAIR_USE_PAID_MEMBERS=unlimited
# FAIR_USE_PAID_STORAGE_BYTES=unlimited
# FAIR_USE_PAID_UPLOAD_BYTES=unlimited

# Largest community archive the server exports or imports, in bytes. Keep twice this much memory.
# MIGRATION_ARCHIVE_MAX_BYTES=536870912

# debug, info, warn, error, or fatal.
LOG_LEVEL=info

# Database pools per process. Keep DB_POOL_MAX plus PGBOSS_POOL_MAX, times the number of
# processes, below the server's max_connections. 0 turns a timeout off. The statement timeout
# defaults to 60000 for web and to off for the worker.
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=60000
# DB_IDLE_IN_TX_TIMEOUT_MS=60000
# PGBOSS_POOL_MAX=3

# Worker healthcheck heartbeat and the notifications fanout poll interval (0.5 to 60 seconds).
# WORKER_HEARTBEAT_FILE=/tmp/cohory-worker.heartbeat
# WORKER_HEARTBEAT_MAX_AGE_MS=90000
# WORKER_FANOUT_POLL_SECONDS=2

# Versioned auth secrets, current first (2:<new>,1:<old>). Keep BETTER_AUTH_SECRET set as well.
# BETTER_AUTH_SECRETS=

# Rate limits per web process, as max/seconds. Per client address: sign up, sign in, password
# reset, invite redemption. Per member: invites, posts, comments, likes, RSVPs, join requests,
# reports. Never set RATE_LIMIT_DISABLED=true in production.
# RATE_LIMIT_SIGN_UP=5/600
# RATE_LIMIT_SIGN_IN=10/60
# RATE_LIMIT_SIGN_IN_ACCOUNT=50/900
# RATE_LIMIT_PASSWORD_RESET=5/600
# RATE_LIMIT_INVITE_CREATE=30/3600
# RATE_LIMIT_INVITE_REDEEM=10/600
# RATE_LIMIT_POSTS=10/60
# RATE_LIMIT_COMMENTS=30/60
# RATE_LIMIT_REACTIONS=120/60
# RATE_LIMIT_RSVPS=30/60
# RATE_LIMIT_JOIN_REQUESTS=10/600
# RATE_LIMIT_SEARCH=30/60
# RATE_LIMIT_REPORTS=10/600
# RATE_LIMIT_MIGRATION_PREVIEWS=50/3600
# RATE_LIMIT_MIGRATION_IMPORTS=10/3600
# RATE_LIMIT_MEMBER_IMPORTS=20/3600
# RATE_LIMIT_API_TOKENS=60/60
# RATE_LIMIT_AGENT_REQUESTS=30/60
# RATE_LIMIT_AGENT_WRITES=30/3600
# RATE_LIMIT_OAUTH_REGISTER=10/3600
# RATE_LIMIT_OAUTH_TOKEN=30/60
# RATE_LIMIT_AGENT_DOWNLOADS=30/60
# RATE_LIMIT_TOKEN_REGENERATE=10/3600
# RATE_LIMIT_EMAIL_OPT_OUT=10/600
# RATE_LIMIT_EMAIL_WEBHOOK=60/60
# RATE_LIMIT_DATA_EXPORT_DOWNLOADS=10/3600
# RATE_LIMIT_CONTACT_IP_HOUR=5/3600
# RATE_LIMIT_CONTACT_IP_DAY=20/86400
# RATE_LIMIT_CONTACT_ACCOUNT=10/86400
# RATE_LIMIT_DISABLED=false
