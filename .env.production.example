# Production settings for docker-compose.prod.yml. Copy to .env and fill in every value marked
# "required". Generate secrets with `openssl rand -base64 32`. See docs/operations/install.md.

# Required. Public host name. Point its DNS A (and AAAA) record at this server before the first
# start so Caddy can get a certificate.
DOMAIN=community.example.com
# Required. Address the certificate authority (Let's Encrypt) uses for expiry notices.
ACME_EMAIL=you@example.com
# Public URL. Defaults to https://$DOMAIN, so leave it commented out unless you serve another URL.
# APP_URL=https://community.example.com

# Required. Release to run. Pin an exact version (0.12.0) or a minor tag (0.12), never latest.
COHORY_VERSION=0.12.0
# Image name. The published image is the default. Set it to cohory to run an
# image you built on this server with `docker compose build`.
COHORY_IMAGE=ghcr.io/cohory/cohory

# Required. Session signing secret, at least 32 characters, from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Optional. Versioned secrets, current first (2:<new>,1:<old>). Changing the first entry still
# signs everyone out; see docs/operations/operator-guide.md, Rotating secrets.
# BETTER_AUTH_SECRETS=
# Optional. true allows an http:// APP_URL on a private network (LAN, Tailscale). Anyone on that
# network can then read session cookies in transit. Leave unset for a public server.
# ALLOW_INSECURE_HTTP=
# Required. Database passwords. Compose builds the connection strings from these, so use letters
# and digits only (`openssl rand -hex 32`); `/`, `+`, `=`, `@`, and `:` break the URL.
POSTGRES_USER=cohory
POSTGRES_PASSWORD=
POSTGRES_DB=cohory
POSTGRES_APP_USER=cohory_app
POSTGRES_APP_PASSWORD=

# Outgoing email. Any SMTP server works.
EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cohory <no-reply@community.example.com>

# Uploads. local keeps them in the uploads volume; s3 uses any S3 compatible service.
STORAGE_DRIVER=local
STORAGE_MAX_UPLOAD_BYTES=26214400

# Edition. Self-hosted servers keep community (no platform fee, no fair use limits by default).
COHORY_EDITION=community
# Optional fair use caps per community (whole number or unlimited). See docs/self-hosting.md.
# FAIR_USE_MEMBERS=unlimited
# FAIR_USE_STORAGE_BYTES=unlimited
# FAIR_USE_UPLOAD_BYTES=unlimited

# Required when creators connect their own Stripe keys or Polar: encrypts those keys at rest. 32 bytes,
# base64 encoded. Back it up with the database. To rotate it, see docs/operations/operator-guide.md.
PAYMENTS_ENCRYPTION_KEY=
# PAYMENTS_ENCRYPTION_KEYS=

LOG_LEVEL=info

# Host bindings for Caddy. Keep the defaults on a public server.
# HTTP_BIND=0.0.0.0:80
# HTTPS_BIND=0.0.0.0:443
# Memory limits (REQ-NFR-HOST-002 budget for a 2 vCPU, 4 GB server).
# WEB_MEMORY_LIMIT=1g
# WORKER_MEMORY_LIMIT=512m
# POSTGRES_MEMORY_LIMIT=1g
# CADDY_MEMORY_LIMIT=256m
# Container log rotation, per container.
# LOG_MAX_SIZE=10m
# LOG_MAX_FILE=5
